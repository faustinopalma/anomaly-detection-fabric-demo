{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.css", "/*.js", "/*.ico", "/*.png", "/*.svg"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
